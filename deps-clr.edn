;; CLR coordinates. `cljr` and `nos` read this file in place of deps.edn.
;; src/ is left out: rct-clr.gen needs rewrite-clj and tools.namespace, so only
;; the example namespaces compile on the CLR.
{:paths ["examples" "examples_clr"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {;; ClojureCLR's test runner, driving `cljr -X:test`
                       io.github.dmiller/test-runner {:git/tag "v0.5.3clr"
                                                      :git/sha "ae91dd2727bbf70eb3a6d869a19953de3819dfbc"}
                       ;; clr-support, not master: only that branch ships a deps-clr.edn
                       flybot-sg/matcho              {:git/url "https://github.com/flybot-sg/matcho"
                                                      :git/sha "fba2a65485f4d5b1e0a69f94a3d06c467478f53f"}}
         :exec-fn     cognitect.test-runner.api/test
         ;; cljr would load the JVM-only suites in test/ and fail on their requires
         :exec-args   {:dirs     ["test"]
                       :patterns ["rct-clr\\.sample-generated-test"]}}}}
